<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>            <string>Octomancer</string>
  <key>CFBundleDisplayName</key>     <string>Octomancer</string>
  <key>CFBundleExecutable</key>      <string>Octomancer</string>
  <key>CFBundleIdentifier</key>      <string>dev.dabbelt.octomancer</string>
  <key>CFBundlePackageType</key>     <string>APPL</string>
  <key>CFBundleShortVersionString</key> <string>@PACKAGE_VERSION@</string>
  <key>CFBundleVersion</key>         <string>@PACKAGE_VERSION@</string>
  <key>LSMinimumSystemVersion</key>  <string>11.0</string>

  <!--
    A menu-bar accessory, not an application: no Dock tile, no menu bar of its
    own, and it does not take focus when it starts.
  -->
  <key>LSUIElement</key>             <true/>
  <key>NSHighResolutionCapable</key> <true/>
  <key>NSSupportsAutomaticTermination</key> <false/>
</dict>
</plist>
